{
  "name": "opencode-v2-kiro-auth",
  "version": "0.1.0",
  "description": "Use Kiro models (Claude Fable 5.1, Claude Opus 5.5, GPT 5.6 Sol) in opencode v2 with AWS Builder ID, IAM Identity Center, or Kiro API-key authentication, with effort variants and Kiro-backed web search.",
  "type": "module",
  "main": "./server.ts",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts"
  },
  "license": "MIT",
  "author": "Hongyi Lyu <git@hongy.io>",
  "homepage": "https://github.com/hongyilyu/opencode-v2-kiro-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongyilyu/opencode-v2-kiro-auth.git"
  },
  "bugs": {
    "url": "https://github.com/hongyilyu/opencode-v2-kiro-auth/issues"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "opencode-plugin",
    "kiro",
    "kiro-cli",
    "codewhisperer",
    "amazon-q",
    "aws-sso"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "server.ts",
    "src",
    "opencode.example.jsonc",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run script/check.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.4"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.20",
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
