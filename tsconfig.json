{
  // First typecheck gate for this package. Bun executes the TypeScript directly (no build),
  // so this config is checking-only: noEmit, with Bun's recommended bundler-style resolution.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,

    // Bun runtime globals + the bun:test module.
    "types": ["bun"]
  },
  // script/ is typechecked but never executed by CI: check.ts is a manual, live-credential tool
  // that spawns opencode 2.x against a real account.
  "include": ["server.ts", "src/**/*", "test/**/*", "script/**/*"]
}
